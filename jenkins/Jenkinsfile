pipeline {
    agent any
    tools {
        maven 'maven 3.9.6' 
    }
    stages {
        stage('Build') {
            steps {
                sh 'mvn -B -DskipTests clean package'
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        stage('Deliver') {
            steps {
                sh 'bash ./jenkins/scripts/deliver.sh'
         
                echo "Deploying and running the application..."
                
                sh '''
                    # 1. Safely locate and stop any old instance running on port 8082
                    PID=$(lsof -t -i:8082) || true
                    if [ ! -z "$PID" ]; then
                        echo "Killing old process: $PID"
                        kill -9 $PID || true
                    fi
                    
                    # 2. Tell Jenkins not to kill our background process tree
                    export JENKINS_NODE_COOKIE=dontKillMe
                    
                    # 3. Launch the jar into a true detached background process
                    nohup java -jar target/MyImageUpload3Domains.jar \
                        --server.port=8082 \
                        --spring.profiles.active=prod > backend_app.log 2>&1 &
                    
                    # 4. Give the application a few seconds to start booting up
                    sleep 5
                '''
                
                echo "Application is booting up on port 8082..."
            }
        }
    }
}
